# Supabase project the app talks to.
NEXT_PUBLIC_SUPABASE_URL=
# Either name works: the Vercel Supabase integration injects the ANON_KEY
# form, a hand-configured project usually gets the PUBLISHABLE_KEY form.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Integration test logins (copy to .env.test.local -- never commit real values).
# Two admin accounts in two DIFFERENT tenants; the RLS suite proves neither
# can see the other's rows.
TEST_TENANT_A_EMAIL=
TEST_TENANT_A_PASSWORD=
TEST_TENANT_B_EMAIL=
TEST_TENANT_B_PASSWORD=

# ---------------------------------------------------------------------------
# NOT for this file, and not for Vercel: provider secrets
# ---------------------------------------------------------------------------
# These belong on the Supabase Edge Functions and nowhere else. The Next.js app
# has never held one and must not start -- that split is the whole reason the
# functions exist (CLAUDE.md rule 6, "secrets never enter the Next.js app").
#
#   razorpay-create-link / razorpay-webhook
#     RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET
#
#   notify-dispatch
#     RESEND_API_KEY                              (email)
#     TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN       (SMS)
#     TWILIO_FROM_NUMBER                          (optional fallback sender)
#
# Set them with `supabase secrets set NAME=value`. With none of them set the
# dispatcher still runs: it reports every channel as unconfigured, claims
# nothing, and the Channels screen says which variable is missing.
