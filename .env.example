# Supabase project the app talks to.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Integration test logins (copy to .env.test.local -- never commit real values).
# Two admin accounts in two DIFFERENT tenants; the RLS suite proves neither
# can see the other's rows.
TEST_TENANT_A_EMAIL=
TEST_TENANT_A_PASSWORD=
TEST_TENANT_B_EMAIL=
TEST_TENANT_B_PASSWORD=
