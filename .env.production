# Build-time configuration for deployed environments.
#
# Both values below are PUBLIC by design: NEXT_PUBLIC_* variables are inlined
# into the client bundle, and Supabase's publishable key is meant to be shipped
# to browsers. The security boundary is Row Level Security in Postgres, not the
# secrecy of this key -- see CLAUDE.md.
#
# The service_role key is NOT here and must never be: it bypasses RLS. Anything
# that needs it (Edge Functions processing the jobs queue) reads it from the
# Supabase platform's own secret storage.
NEXT_PUBLIC_SUPABASE_URL=https://bbwdkglcndaoiqmzdliq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_k2-zXIM3q6Kyeo2-3VXRUQ_qr-mHF86
